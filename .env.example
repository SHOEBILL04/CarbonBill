# ==============================================================================
# CarbonBill Environment Variables Template
# Copy to .env for local development or set in Railway / Render Dashboard
# ==============================================================================

# Core Runtime
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# JWT Authentication (generate a secure random 32+ character secret)
JWT__SECRET=replace-with-a-secure-random-32-byte-base64-secret-key-123456=

# Database Connection (Default uses SQLite on the /data volume)
ConnectionStrings__DefaultConnection="Data Source=/data/carbonbill.db;Cache=Shared"
ConnectionStrings__HangfireConnection="/data/hangfire.db"

# Groq Vision & LLM (Get free API key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini (Get free API key from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# LangSmith AI Observability & Evaluation (Optional, https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here
LANGSMITH_PROJECT=CarbonBill

# OCR Configuration
OCR_PROVIDER=Tesseract

# Cloud Keep-Alive (Prevents free tier sleep; optional on Railway)
KEEP_ALIVE_INTERVAL_MINUTES=12
