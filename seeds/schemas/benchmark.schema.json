{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonbill.org/schemas/benchmark.json",
  "title": "BenchmarkCollection",
  "description": "Schema for sector peer emissions intensity distribution benchmarks",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "sector": { "type": "string" },
      "size_band": { "type": "string" },
      "metric": { "type": "string" },
      "unit": { "type": "string" },
      "p25": { "type": ["number", "null"] },
      "p50": { "type": ["number", "null"] },
      "p75": { "type": ["number", "null"] },
      "p90": { "type": ["number", "null"] },
      "n": { "type": "integer", "minimum": 0 },
      "min_n_required": { "type": "integer", "default": 10 },
      "source": { "type": "string" },
      "year": { "type": "integer" },
      "notes": { "type": "string" }
    },
    "required": [
      "sector",
      "size_band",
      "metric",
      "unit",
      "n",
      "min_n_required",
      "source",
      "year"
    ]
  }
}
