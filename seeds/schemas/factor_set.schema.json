{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonbill.org/schemas/factor-set.json",
  "title": "FactorSetRecord",
  "description": "Schema for greenhouse gas emission factor sets and items",
  "type": "object",
  "properties": {
    "set_name": { "type": "string" },
    "gwp_basis": { "type": "string", "enum": ["AR5", "AR6"] },
    "source": { "type": "string" },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "region": { "type": "string" },
    "version": { "type": "string" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" },
    "activity_type": { "type": "string" },
    "canonical_unit": { "type": "string", "enum": ["kWh", "litre", "kg", "m3", "tonne-km"] },
    "factor_value": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "source_needed": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "required": [
    "set_name",
    "gwp_basis",
    "source",
    "year",
    "region",
    "version",
    "activity_type",
    "canonical_unit",
    "source_needed"
  ]
}
